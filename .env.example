# =======================================================
# CONFIGURAÇÃO DE AMBIENTE - MC SECURITIZADORA OPEN FINANCE
# (Copie este arquivo para .env e preencha com as credenciais reais)
# =======================================================

# 1. Ambiente e Credenciais da API Pluggy (Obtidas no dashboard da Pluggy.ai)
# PLUGGY_ENVIRONMENT: 'development' | 'sandbox' | 'staging' | 'production'
# Em development/sandbox/staging, injeta automaticamente sandbox=true nas consultas de conectores para habilitar bancos de teste (Agibank, etc).
PLUGGY_ENVIRONMENT=development
PLUGGY_CLIENT_ID=seu_client_id_pluggy_aqui
PLUGGY_CLIENT_SECRET=seu_client_secret_pluggy_aqui

# 2. Identificador de Recebedor para Pix Automático na Pluggy e Segredo de Webhook
PLUGGY_RECIPIENT_ID=seu_recipient_id_pluggy_aqui
PLUGGY_WEBHOOK_SECRET=seu_webhook_secret_pluggy_aqui

# 3. Credenciais do Banco de Dados Supabase
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_KEY=sua-chave-service-role-ou-anon-aqui

# 4. Chave Secreta para Assinatura de Tokens de Autenticação do Gestor
SECRET_KEY=gere_uma_chave_aleatoria_longa_e_segura_hex_ou_base64_aqui

# 5. Usuários autorizados no Portal do Gestor (Formato: usuario:senha separados por vírgula)
# Usuários padrão corporativos:
# - admin : securitizadora2026
# - julianemc : MC@2026
# - gabriel : MC@2026
GESTOR_USERS=admin:securitizadora2026,julianemc:MC@2026,gabriel:MC@2026

# 6. URLs da Aplicação e Políticas CORS
FRONTEND_URL=https://vitrine-openfinance.onrender.com
CORS_ORIGINS=https://vitrine-openfinance.onrender.com,http://localhost:5000

# 7. Porta do Servidor Web (Preenchida automaticamente pelo Render com $PORT)
PORT=5000
